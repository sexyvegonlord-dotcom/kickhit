--============================================================
-- GET TOOLS
--============================================================

local function getTools()

	local tools = {}

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, item in ipairs(backpack:GetChildren()) do

			if item:IsA("Tool") then
				table.insert(tools, item)
			end

		end

	end

	if player.Character then

		for _, item in ipairs(player.Character:GetChildren()) do

			if item:IsA("Tool") then
				table.insert(tools, item)
			end

		end

	end

	table.sort(tools, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return tools

end

--============================================================
-- REFRESH TOOL LIST
--============================================================

local function refreshTools()

	for _, child in ipairs(toolList:GetChildren()) do

		if child:IsA("TextButton") then
			child:Destroy()
		end

	end

	local tools = getTools()

	for _, tool in ipairs(tools) do

		local button = Instance.new("TextButton")

		button.Name = "ToolButton"
		button.Size = UDim2.new(1, -4, 0, 31)
		button.BackgroundColor3 = Color3.fromRGB(61, 43, 26)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.Garamond
		button.Text = "  ⚒  " .. tool.Name
		button.TextColor3 = Color3.fromRGB(211, 178, 111)
		button.TextSize = 14
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Parent = toolList

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = button

		button.MouseEnter:Connect(function()

			if selectedTool ~= tool then

				button.BackgroundColor3 =
					Color3.fromRGB(86, 59, 32)

			end

		end)

		button.MouseLeave:Connect(function()

			if selectedTool ~= tool then

				button.BackgroundColor3 =
					Color3.fromRGB(61, 43, 26)

			end

		end)

		button.MouseButton1Click:Connect(function()

			selectedTool = tool

			selectedLabel.Text =
				"SELECTED: " .. tool.Name

			for _, other in ipairs(toolList:GetChildren()) do

				if other:IsA("TextButton") then

					other.BackgroundColor3 =
						Color3.fromRGB(61, 43, 26)

				end

			end

			button.BackgroundColor3 =
				Color3.fromRGB(116, 77, 34)

			status.Text =
				"STATUS: " .. tool.Name .. " SELECTED"

		end)

	end

	task.wait()

	toolList.CanvasSize =
		UDim2.new(
			0,
			0,
			0,
			listLayout.AbsoluteContentSize.Y + 12
		)

end

--============================================================
-- WAIT FOR PARENT
--============================================================

local function waitForParent(tool, expectedParent, timeout)

	local start = os.clock()

	while tool
		and tool.Parent ~= expectedParent
		and os.clock() - start < timeout do

		task.wait()

	end

	return tool
		and tool.Parent == expectedParent

end

--============================================================
-- EQUIP
--============================================================

local function equipTool(tool)

	if not tool then
		return false
	end

	local character = player.Character
	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not character or not backpack then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if tool.Parent == character then
		return true
	end

	if tool.Parent ~= backpack then
		return false
	end

	humanoid:EquipTool(tool)

	return waitForParent(
		tool,
		character,
		1
	)

end

--============================================================
-- UNEQUIP
--============================================================

local function unequipTool(tool)

	if not tool then
		return false
	end

	local character = player.Character
	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not character or not backpack then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if tool.Parent == backpack then
		return true
	end

	if tool.Parent == character then

		humanoid:UnequipTools()

		return waitForParent(
			tool,
			backpack,
			1
		)

	end

	return false

end

--============================================================
-- EQUIPPED CHECK
--============================================================

local function isEquipped(tool)

	return tool
		and player.Character
		and tool.Parent == player.Character

end

--============================================================
-- COMBAT MODE CHECK
--============================================================

local function getCombatMode()

	local charactersFolder =
		workspace:FindFirstChild("Characters")

	if not charactersFolder then
		return nil
	end

	local characterFolder =
		charactersFolder:FindFirstChild(player.Name)

	if not characterFolder then
		return nil
	end

	local pvp =
		characterFolder:FindFirstChild("Pvp")

	if not pvp then
		return nil
	end

	local combatMode =
		pvp:FindFirstChild("CombatMode")

	if not combatMode then
		return nil
	end

	if not combatMode:IsA("BoolValue") then
		return nil
	end

	return combatMode

end

--============================================================
-- ACTIVATE UNTIL COMBAT MODE
--============================================================

local function activateUntilCombatMode(tool)

	local startTime = os.clock()

	while cycleRunning do

		-- Check CombatMode BEFORE activating.
		local combatMode = getCombatMode()

		if combatMode and combatMode.Value == true then
			return true
		end

		-- Safety timeout.
		if os.clock() - startTime >= COMBAT_MODE_TIMEOUT then
			return false
		end

		-- Make sure the tool is still equipped.
		if not isEquipped(tool) then
			return false
		end

		-- Activate / left click.
		leftClickTool(tool)

		task.wait(COMBAT_ACTIVATE_INTERVAL)

	end

	return false

end

--============================================================
-- R PHASE
--============================================================

local function firstRPhase(tool)

	local startTime = os.clock()

	while cycleRunning
		and os.clock() - startTime < FIRST_R_DURATION do

		if not isEquipped(tool) then
			return false
		end

		pressR()

		if not cycleRunning then
			return false
		end

		task.wait(R_INTERVAL)

	end

	return true

end

--============================================================
-- FINAL R + LEFT CLICK PHASE
--============================================================

local function combinedPhase(tool)

	while cycleRunning do

		if not isEquipped(tool) then
			return
		end

		-- R
		pressR()

		if not cycleRunning then
			return
		end

		-- LEFT CLICK / TOOL ACTIVATE
		if isEquipped(tool) then
			leftClickTool(tool)
		else
			return
		end

		task.wait(COMBINED_INTERVAL)

	end

end

--============================================================
-- MAIN SEQUENCE
--============================================================

local function runSequence()

	if not selectedTool then

		status.Text =
			"STATUS: SELECT A TOOL FIRST"

		return

	end

	cycleRunning = true

	actionButton.Text =
		"■  STOP"

	task.spawn(function()

		local tool = selectedTool

		--====================================================
		-- INITIAL EQUIP
		--====================================================

		status.Text =
			"STATUS: EQUIPPING"

		if not equipTool(tool) then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: EQUIP FAILED"

			return

		end

		task.wait(EQUIP_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- INITIAL LEFT CLICK
		--====================================================

		status.Text =
			"STATUS: FIRST LEFT CLICK"

		leftClickTool(tool)

		task.wait(0.05)

		if not cycleRunning then
			return
		end

		--====================================================
		-- INITIAL R SPAM
		--====================================================

		status.Text =
			"STATUS: R SPAM | INITIAL"

		local completed =
			firstRPhase(tool)

		if not completed then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: STOPPED"

			return

		end

		if not cycleRunning then
			return
		end

		--====================================================
		-- NORMAL CYCLES
		--====================================================

		for cycle = 1, NORMAL_CYCLES do

			if not cycleRunning then
				return
			end

			--================================================
			-- UNEQUIP
			--================================================

			status.Text =
				"STATUS: UNEQUIPPING | CYCLE "
				.. cycle
				.. "/"
				.. NORMAL_CYCLES

			if not unequipTool(tool) then

				cycleRunning = false

				actionButton.Text =
					"⚔  KICK + HIT"

				status.Text =
					"STATUS: UNEQUIP FAILED"

				return

			end

			-- R is completely stopped here.

			task.wait(UNEQUIP_DELAY)

			if not cycleRunning then
				return
			end

			--================================================
			-- RE-EQUIP
			--================================================

			status.Text =
				"STATUS: RE-EQUIPPING | CYCLE "
				.. cycle
				.. "/"
				.. NORMAL_CYCLES

			if not equipTool(tool) then

				cycleRunning = false

				actionButton.Text =
					"⚔  KICK + HIT"

				status.Text =
					"STATUS: RE-EQUIP FAILED"

				return

			end

			task.wait(EQUIP_DELAY)

			if not cycleRunning then
				return
			end

			--================================================
			-- ACTIVATE UNTIL COMBAT MODE = TRUE
			--================================================

			status.Text =
				"STATUS: ACTIVATING | CYCLE "
				.. cycle
				.. "/"
				.. NORMAL_CYCLES

			local combatStarted =
				activateUntilCombatMode(tool)

			if not combatStarted then

				cycleRunning = false

				actionButton.Text =
					"⚔  KICK + HIT"

				status.Text =
					"STATUS: COMBAT MODE TIMEOUT"

				return

			end

			if not cycleRunning then
				return
			end

			--================================================
			-- R SPAM
			--================================================

			status.Text =
				"STATUS: R SPAM | CYCLE "
				.. cycle
				.. "/"
				.. NORMAL_CYCLES

			local cycleCompleted =
				firstRPhase(tool)

			if not cycleCompleted then

				cycleRunning = false

				actionButton.Text =
					"⚔  KICK + HIT"

				status.Text =
					"STATUS: STOPPED"

				return

			end

		end

		--====================================================
		-- FINAL UNEQUIP
		--====================================================

		if not cycleRunning then
			return
		end

		status.Text =
			"STATUS: FINAL UNEQUIP"

		if not unequipTool(tool) then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: FINAL UNEQUIP FAILED"

			return

		end

		task.wait(UNEQUIP_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- FINAL RE-EQUIP
		--====================================================

		status.Text =
			"STATUS: FINAL RE-EQUIP"

		if not equipTool(tool) then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: FINAL RE-EQUIP FAILED"

			return

		end

		task.wait(EQUIP_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- FINAL LEFT CLICK
		--====================================================

		status.Text =
			"STATUS: FINAL LEFT CLICK"

		leftClickTool(tool)

		task.wait(0.10)

		if not cycleRunning then
			return
		end

		if not isEquipped(tool) then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: TOOL UNEQUIPPED"

			return

		end

		--====================================================
		-- FINAL R + LEFT CLICK SPAM
		--====================================================

		status.Text =
			"STATUS: R + LEFT CLICK"

		combinedPhase(tool)

		--====================================================
		-- END
		--====================================================

		cycleRunning = false

		actionButton.Text =
			"⚔  KICK + HIT"

		status.Text =
			"STATUS: READY"

	end)

end

