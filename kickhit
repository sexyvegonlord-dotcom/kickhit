-- INVENTORY REFRESH
--============================================================

local backpack =
	player:WaitForChild("Backpack")

backpack.ChildAdded:Connect(function(child)

	if child:IsA("Tool") then

		task.wait()

		refreshTools()

	end

end)

backpack.ChildRemoved:Connect(function(child)

	if child:IsA("Tool") then

		task.wait()

		refreshTools()

	end

end)

player.CharacterAdded:Connect(function()

	task.wait(1)

	refreshTools()

end)

--============================================================
-- INITIALIZE
--============================================================

