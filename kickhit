local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 3)
listLayout.Parent = toolList

local function refreshToolList()
	for _, child in ipairs(toolList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local tools = {}

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, obj in ipairs(backpack:GetChildren()) do
			if obj:IsA("Tool") then
				table.insert(tools, obj)
			end
		end
	end

	local character = getCharacter()
	if character then
		for _, obj in ipairs(character:GetChildren()) do
			if obj:IsA("Tool") and not table.find(tools, obj) then
				table.insert(tools, obj)
			end
		end
	end

	for _, tool in ipairs(tools) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -6, 0, 25)
		button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		button.Text = tool.Name
		button.TextColor3 = Color3.fromRGB(230, 230, 230)
		button.TextSize = 11
		button.Font = Enum.Font.Gotham
		button.BorderSizePixel = 0
		button.Parent = toolList

		local buttonCorner = Instance.new("UICorner")
		buttonCorner.CornerRadius = UDim.new(0, 4)
		buttonCorner.Parent = button

		button.MouseButton1Click:Connect(function()
			selectedTool = tool
			toolButton.Text = "Selected: " .. tool.Name
			toolList.Visible = false
		end)
	end

	toolList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 5)
end

toolButton.MouseButton1Click:Connect(function()
	refreshToolList()
	toolList.Visible = not toolList.Visible
end)

