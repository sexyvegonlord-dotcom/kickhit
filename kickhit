	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Zero then
		toggleAutomation()
	end

end)

--==================================================
-- STOP WHEN TOOL IS UNEQUIPPED
--==================================================

local function monitorCharacter(character)

	character.ChildRemoved:Connect(function(child)

		if child:IsA("Tool")
			and child == selectedTool
			and running then

			stopAutomation()

			setStatus(
				"UNEQUIPPED  •  STOPPED",
				GREY
			)

		end

	end)

end

