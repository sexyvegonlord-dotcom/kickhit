--==================================================
-- START SEQUENCE
--==================================================

local function startAutomation()
	if running then
		return
	end

	if not selectedTool then
		status.Text = "Select a tool first"
		return
	end

	local humanoid = getHumanoid()
	if not humanoid then
		status.Text = "Humanoid not found"
		return
	end

	running = true

	local tool = selectedTool

	-- Equip
	pcall(function()
		humanoid:EquipTool(tool)
	end)

	task.wait(0.15)

	if not running or not isEquipped(tool) then
		stopAutomation()
		status.Text = "Stopped"
		return
	end

	-- LEFT CLICK ONCE
	leftClick(tool)

	--==================================================
	-- LEFT CLICK SPAM
	--==================================================

	clickThread = task.spawn(function()
		while running do
			if not isEquipped(tool) then
				stopAutomation()
				break
			end

			leftClick(tool)
			task.wait(CLICK_INTERVAL)
		end
	end)

	status.Text = "Left-clicking..."

	--==================================================
	-- WAIT BEFORE ADDING R SPAM
	--==================================================

	task.spawn(function()
		task.wait(rDelay)

		if not running or not isEquipped(tool) then
			return
		end

		status.Text = "Left-click + R..."

		--==================================================
		-- R SPAM ON TOP OF LEFT CLICK SPAM
		--==================================================

		rThread = task.spawn(function()
			while running do
				if not isEquipped(tool) then
					stopAutomation()
					break
				end

				pressR()
				task.wait(R_INTERVAL)
			end
		end)
	end)
end

--==================================================
-- TOGGLE
--==================================================

local function toggleAutomation()
	if running then
		stopAutomation()
		status.Text = "Stopped • Press 0"
	else
		startAutomation()
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Zero then
		toggleAutomation()
	end
end)

--==================================================
-- AUTOMATIC STOP WHEN UNEQUIPPED
--==================================================

local function monitorCharacter(character)
	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") and running then
			if child == selectedTool then
				stopAutomation()
				status.Text = "Unequipped • Stopped"
			end
		end
	end)
end

if player.Character then
	monitorCharacter(player.Character)
end

player.CharacterAdded:Connect(function(character)
	stopAutomation()
	status.Text = "Character reset"
	monitorCharacter(character)
end)

