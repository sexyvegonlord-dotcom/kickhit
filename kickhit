--==================================================
-- INVENTORY FUNCTIONS
--==================================================

local function getTools()
	local tools = {}

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end

	if player.Character then
		for _, item in ipairs(player.Character:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end

	table.sort(tools, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return tools
end

--==================================================
-- REFRESH TOOL LIST
--==================================================

local function refreshTools()
	for _, child in ipairs(toolList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local tools = getTools()

	for _, tool in ipairs(tools) do
		local button = Instance.new("TextButton")

		button.Size = UDim2.new(1, -4, 0, 31)
		button.BackgroundColor3 = Color3.fromRGB(61, 43, 26)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.Garamond
		button.Text = "  ⚒  " .. tool.Name
		button.TextColor3 = Color3.fromRGB(211, 178, 111)
		button.TextSize = 14
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Parent = toolList

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = button

		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = Color3.fromRGB(86, 59, 32)
		end)

		button.MouseLeave:Connect(function()
			if selectedTool ~= tool then
				button.BackgroundColor3 = Color3.fromRGB(61, 43, 26)
			end
		end)

		button.MouseButton1Click:Connect(function()
			selectedTool = tool

			selectedLabel.Text = "SELECTED: " .. tool.Name
			selectedLabel.TextColor3 = Color3.fromRGB(238, 200, 121)

			for _, other in ipairs(toolList:GetChildren()) do
				if other:IsA("TextButton") then
					other.BackgroundColor3 = Color3.fromRGB(61, 43, 26)
				end
			end

			button.BackgroundColor3 = Color3.fromRGB(116, 77, 34)
			status.Text = "STATUS: " .. tool.Name .. " SELECTED"
		end)
	end

	task.wait()

	toolList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 12
	)
end

--==================================================
-- EQUIP TOOL
--==================================================

local function equipTool(tool)
	if not tool or not tool.Parent then
		return false
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if tool.Parent == player.Backpack then
		humanoid:EquipTool(tool)
	end

	return true
end

--==================================================
-- LEFT CLICK / TOOL ACTIVATION
--==================================================

local function activateTool(tool)
	if not tool then
		return
	end

	-- Roblox's intended Tool activation method.
	tool:Activate()
end

--==================================================
-- R SPAM
--==================================================

local function startRSpam()
	if rSpamming then
		return
	end

	rSpamming = true

	task.spawn(function()
		while rSpamming and gui.Parent do
			-- Sends the R keyboard input for testing
			VirtualInputManager:SendKeyEvent(
				true,
				Enum.KeyCode.R,
				false,
				game
			)

			task.wait(0.02)

			VirtualInputManager:SendKeyEvent(
				false,
				Enum.KeyCode.R,
				false,
				game
			)

			task.wait(R_SPAM_DELAY)
		end
	end)
end

local function stopRSpam()
	rSpamming = false
end

--==================================================
-- KICK + HIT
--==================================================

actionButton.MouseButton1Click:Connect(function()
	if not selectedTool then
		status.Text = "STATUS: SELECT A TOOL FIRST"
		return
	end

	if not selectedTool.Parent then
		status.Text = "STATUS: TOOL NO LONGER EXISTS"
		refreshTools()
		return
	end

	status.Text = "STATUS: EQUIPPING..."

	local equipped = equipTool(selectedTool)

	if not equipped then
		status.Text = "STATUS: COULD NOT EQUIP"
		return
	end

	task.wait(0.12)

	-- One left-click equivalent
	activateTool(selectedTool)

	task.wait(0.05)

	-- Begin R input loop
	status.Text = "STATUS: R INPUT ACTIVE"
	startRSpam()
end)

