local FIRST_R_DURATION = 2

-- Delay between R presses
local R_INTERVAL = 0.08

-- Delay after second left click before combined spam
local SECOND_CLICK_WAIT = 0.25

-- Delay after equip
local EQUIP_DELAY = 0.15

-- Delay after first unequip
local RESET_DELAY = 0.25

-- Combined R + left click interval
local COMBINED_INTERVAL = 0.08

--============================================================
-- REMOVE PREVIOUS GUI
--============================================================

local oldGui = playerGui:FindFirstChild(GUI_NAME)

if oldGui then
	oldGui:Destroy()
end

--============================================================
-- STATE
--============================================================

local selectedTool = nil
local cycleRunning = false
local minimized = false

--============================================================
-- KEYBOARD R
--============================================================

local function pressR()

	VirtualInputManager:SendKeyEvent(
		true,
		Enum.KeyCode.R,
		false,
		game
	)

	task.wait(0.025)

	VirtualInputManager:SendKeyEvent(
		false,
		Enum.KeyCode.R,
		false,
		game
	)

end

--============================================================
-- LEFT MOUSE CLICK
--============================================================

local function pressLeftMouse()

	VirtualInputManager:SendMouseButtonEvent(
		0,
		0,
		0,
		true,
		game,
		0
	)

	task.wait(0.025)

	VirtualInputManager:SendMouseButtonEvent(
		0,
		0,
		0,
		false,
		game,
		0
	)

end

