local draggingSlider = false

local function updateSlider(mouseX)
	local relative =
		(mouseX - sliderBack.AbsolutePosition.X) /
		sliderBack.AbsoluteSize.X

	relative = math.clamp(relative, 0, 1)

	-- 0.001 SECOND PRECISION
	local rawValue =
		MIN_R_DELAY +
		(MAX_R_DELAY - MIN_R_DELAY) * relative

	rDelay = math.floor(rawValue * 1000 + 0.5) / 1000

	local visualPercent =
		(rDelay - MIN_R_DELAY) /
		(MAX_R_DELAY - MIN_R_DELAY)

	sliderFill.Size = UDim2.new(
		visualPercent,
		0,
		1,
		0
	)

	knob.Position = UDim2.new(
		visualPercent,
		0,
		0.5,
		0
	)

	delayValue.Text = string.format(
		"%.3fs",
		rDelay
	)
end

sliderBack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingSlider = true
		updateSlider(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingSlider
		and input.UserInputType == Enum.UserInputType.MouseMovement then

		updateSlider(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingSlider = false
	end
end)

