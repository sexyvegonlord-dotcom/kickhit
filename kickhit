--==================================================
-- START AUTOMATION
--==================================================

local function startAutomation()
	if running then
		return
	end

	if not selectedTool then
		setStatus("SELECT A TOOL FIRST", RED_BRIGHT)
		return
	end

	local humanoid = getHumanoid()

	if not humanoid then
		setStatus("HUMANOID NOT FOUND", RED_BRIGHT)
		return
	end

	local tool = selectedTool

	running = true

	setStatus("EQUIPPING...", RED_BRIGHT)

	--==================================================
	-- EQUIP
	--==================================================

	pcall(function()
		humanoid:EquipTool(tool)
	end)

	task.wait(EQUIP_DELAY)

	if not running or not isEquipped(tool) then
		stopAutomation()
		setStatus("STOPPED", GREY)
		return
	end

	--==================================================
	-- INITIAL LEFT CLICK
	--==================================================

	leftClick(tool)

	--==================================================
	-- LEFT CLICK SPAM
	--==================================================

	clickThread = task.spawn(function()
		while running do

			if not isEquipped(tool) then
				stopAutomation()
				setStatus("UNEQUIPPED • STOPPED", GREY)
				break
			end

			leftClick(tool)

			task.wait(CLICK_INTERVAL)
		end
	end)

	setStatus("LEFT CLICKING...", RED_BRIGHT)

	--==================================================
	-- WAIT FOR R DELAY
	--==================================================

	delayedRThread = task.spawn(function()

		task.wait(rDelay)

		if not running then
			return
		end

		if not isEquipped(tool) then
			stopAutomation()
			setStatus("UNEQUIPPED • STOPPED", GREY)
			return
		end

		setStatus(
			"CLICK + R  •  " .. string.format("%.3fs", rDelay),
			RED_BRIGHT
		)

		--==================================================
		-- R SPAM
		--==================================================

		rThread = task.spawn(function()

			while running do

				if not isEquipped(tool) then
					stopAutomation()
					setStatus("UNEQUIPPED • STOPPED", GREY)
					break
				end

				pressR()

				task.wait(R_INTERVAL)
			end

		end)

	end)
end

--==================================================
-- TOGGLE
--==================================================

local function toggleAutomation()

	if running then

		stopAutomation()

		setStatus(
			"STOPPED  •  PRESS 0",
			GREY
		)

	else

		startAutomation()

	end

end

