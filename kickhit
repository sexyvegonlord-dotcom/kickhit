--// Roblox Studio - LocalScript
--// Put in StarterPlayer > StarterPlayerScripts
--
--// 0 = Start / Stop
--// Equip selected tool -> left click once
--// Then left-click spam starts
--// After the slider delay, R spam layers on top
--// Unequipping the tool stops everything

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================
-- SETTINGS
--==================================================

local GUI_NAME = "MinimalToolController"

local CLICK_INTERVAL = 0.08
local R_INTERVAL = 0.08

local MIN_R_DELAY = 0
local MAX_R_DELAY = 5
local DEFAULT_R_DELAY = 1

--==================================================
-- CLEAN OLD GUI
--==================================================

local oldGui = playerGui:FindFirstChild(GUI_NAME)
if oldGui then
	oldGui:Destroy()
end

--==================================================
-- STATE
--==================================================

local selectedTool = nil
local running = false
local minimized = false

local rDelay = DEFAULT_R_DELAY

local clickThread = nil
local rThread = nil

--==================================================
-- HELPERS
--==================================================

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local character = getCharacter()
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function isEquipped(tool)
	local character = getCharacter()

	return character
		and tool
		and tool.Parent == character
end

local function stopAutomation()
	running = false

	if clickThread then
		task.cancel(clickThread)
		clickThread = nil
	end

	if rThread then
		task.cancel(rThread)
		rThread = nil
	end
end

local function leftClick(tool)
	if not running then
		return
	end

	if not isEquipped(tool) then
		stopAutomation()
		return
	end

	pcall(function()
		tool:Activate()
	end)
end

local function pressR()
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	end)
end

