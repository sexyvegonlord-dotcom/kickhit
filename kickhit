--============================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)

	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Zero then

		if cycleRunning then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: STOPPED"

		else

			runSequence()

		end

	end

end)

--============================================================
