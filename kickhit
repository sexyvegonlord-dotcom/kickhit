--==================================================
-- REFRESH TOOLS
--==================================================

local function refreshToolList()
	for _, child in ipairs(toolList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local tools = {}

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, obj in ipairs(backpack:GetChildren()) do
			if obj:IsA("Tool") then
				table.insert(tools, obj)
			end
		end
	end

	local character = getCharacter()

	if character then
		for _, obj in ipairs(character:GetChildren()) do
			if obj:IsA("Tool") and not table.find(tools, obj) then
				table.insert(tools, obj)
			end
		end
	end

	for _, tool in ipairs(tools) do
		local button = Instance.new("TextButton")

		button.Size = UDim2.new(1, -8, 0, 27)
		button.BackgroundColor3 = PANEL2
		button.Text = tool.Name
		button.TextColor3 = WHITE
		button.TextSize = 10
		button.Font = Enum.Font.Gotham
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.BorderSizePixel = 0
		button.Parent = toolList

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 10)
		padding.Parent = button

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = button

		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = RED_DARK
		end)

		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = PANEL2
		end)

		button.MouseButton1Click:Connect(function()
			selectedTool = tool

			toolButton.Text = "†  " .. tool.Name

			toolList.Visible = false
		end)
	end

	toolList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		listLayout.AbsoluteContentSize.Y + 5
	)
end

toolButton.MouseButton1Click:Connect(function()
	refreshToolList()

	toolList.Visible = not toolList.Visible
end)

