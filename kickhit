--============================================================
-- SETTINGS
--============================================================

local GUI_NAME = "BronzeAgeArmory"

-- CHANGE THIS NUMBER
local NORMAL_CYCLES = 3

local FIRST_R_DURATION = 2
local R_INTERVAL = 0.08

local EQUIP_DELAY = 0.15
local UNEQUIP_DELAY = 0.25

local COMBINED_INTERVAL = 0.08

-- How often the tool is activated while waiting
-- for CombatMode to become true.
local COMBAT_ACTIVATE_INTERVAL = 0.08

-- Safety timeout for the CombatMode activation phase.
local COMBAT_MODE_TIMEOUT = 5

--============================================================
-- REMOVE OLD GUI
--============================================================

local oldGui = playerGui:FindFirstChild(GUI_NAME)

if oldGui then
	oldGui:Destroy()
end

--============================================================
-- STATE
--============================================================

local selectedTool = nil
local cycleRunning = false
local minimized = false

--============================================================
-- R KEY
--============================================================

local function pressR()

	VirtualInputManager:SendKeyEvent(
		true,
		Enum.KeyCode.R,
		false,
		game
	)

	task.wait(0.02)

	VirtualInputManager:SendKeyEvent(
		false,
		Enum.KeyCode.R,
		false,
		game
	)

end

--============================================================
-- ACTIVATE / LEFT CLICK
--============================================================

local function leftClickTool(tool)

	if not tool then
		return
	end

	if not player.Character then
		return
	end

	if tool.Parent ~= player.Character then
		return
	end

	tool:Activate()

end

