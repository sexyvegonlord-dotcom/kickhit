--==================================================
-- HELPERS
--==================================================

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function isEquipped(tool)
	local character = getCharacter()

	return character
		and tool
		and tool.Parent == character
end

local function cancelThread(thread)
	if thread then
		pcall(function()
			task.cancel(thread)
		end)
	end
end

local function stopAutomation()
	running = false

	cancelThread(clickThread)
	cancelThread(rThread)
	cancelThread(delayedRThread)

	clickThread = nil
	rThread = nil
	delayedRThread = nil
end

local function leftClick(tool)
	if not running then
		return false
	end

	if not isEquipped(tool) then
		stopAutomation()
		return false
	end

	pcall(function()
		tool:Activate()
	end)

	return true
end

local function pressR()
	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.R,
			false,
			game
		)

		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.R,
			false,
			game
		)
	end)
end

