--============================================================
-- GET TOOLS
--============================================================

local function getTools()

	local tools = {}

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, item in ipairs(backpack:GetChildren()) do

			if item:IsA("Tool") then
				table.insert(tools, item)
			end

		end

	end

	if player.Character then

		for _, item in ipairs(player.Character:GetChildren()) do

			if item:IsA("Tool") then
				table.insert(tools, item)
			end

		end

	end

	table.sort(tools, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return tools

end

--============================================================
-- REFRESH TOOLS
--============================================================

local function refreshTools()

	for _, child in ipairs(toolList:GetChildren()) do

		if child:IsA("TextButton") then
			child:Destroy()
		end

	end

	local tools = getTools()

	for _, tool in ipairs(tools) do

		local button = Instance.new("TextButton")

		button.Name = "ToolButton"
		button.Size = UDim2.new(1, -4, 0, 31)
		button.BackgroundColor3 = Color3.fromRGB(61, 43, 26)
		button.BorderSizePixel = 0
		button.Font = Enum.Font.Garamond
		button.Text = "  ⚒  " .. tool.Name
		button.TextColor3 = Color3.fromRGB(211, 178, 111)
		button.TextSize = 14
		button.TextXAlignment = Enum.TextXAlignment.Left
		button.Parent = toolList

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = button

		button.MouseEnter:Connect(function()

			if selectedTool ~= tool then

				button.BackgroundColor3 =
					Color3.fromRGB(86, 59, 32)

			end

		end)

		button.MouseLeave:Connect(function()

			if selectedTool ~= tool then

				button.BackgroundColor3 =
					Color3.fromRGB(61, 43, 26)

			end

		end)

		button.MouseButton1Click:Connect(function()

			selectedTool = tool

			selectedLabel.Text =
				"SELECTED: " .. tool.Name

			for _, other in ipairs(toolList:GetChildren()) do

				if other:IsA("TextButton") then

					other.BackgroundColor3 =
						Color3.fromRGB(61, 43, 26)

				end

			end

			button.BackgroundColor3 =
				Color3.fromRGB(116, 77, 34)

			status.Text =
				"STATUS: " .. tool.Name .. " SELECTED"

		end)

	end

	task.wait()

	toolList.CanvasSize =
		UDim2.new(
			0,
			0,
			0,
			listLayout.AbsoluteContentSize.Y + 12
		)

end

--============================================================
-- WAIT FOR TOOL PARENT
--============================================================

local function waitForParent(tool, expectedParent, timeout)

	local start = os.clock()

	while tool
		and tool.Parent ~= expectedParent
		and os.clock() - start < timeout do

		task.wait()

	end

	return tool
		and tool.Parent == expectedParent

end

--============================================================
-- EQUIP
--============================================================

local function equipTool(tool)

	if not tool then
		return false
	end

	local character = player.Character
	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not character or not backpack then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if tool.Parent == character then
		return true
	end

	if tool.Parent ~= backpack then
		return false
	end

	humanoid:EquipTool(tool)

	return waitForParent(
		tool,
		character,
		1
	)

end

--============================================================
-- UNEQUIP
--============================================================

local function unequipTool(tool)

	if not tool then
		return false
	end

	local character = player.Character
	local backpack =
		player:FindFirstChildOfClass("Backpack")

	if not character or not backpack then
		return false
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	-- Already unequipped
	if tool.Parent == backpack then
		return true
	end

	if tool.Parent == character then

		humanoid:UnequipTools()

		return waitForParent(
			tool,
			backpack,
			1
		)

	end

	return false

end

--============================================================
-- CHECK TOOL IS EQUIPPED
--============================================================

local function isToolEquipped(tool)

	return tool
		and player.Character
		and tool.Parent == player.Character

end

--============================================================
-- ACTIVATE TOOL
--============================================================

local function activateTool(tool)

	if not tool then
		return
	end

	if isToolEquipped(tool) then
		tool:Activate()
	end

end

--============================================================
-- FIRST R PHASE
--============================================================

local function runFirstRPhase(tool)

	local startTime = os.clock()

	while cycleRunning
		and os.clock() - startTime < FIRST_R_DURATION do

		-- If tool becomes unequipped,
		-- immediately stop R spam.
		if not isToolEquipped(tool) then
			return false
		end

		pressR()

		task.wait(R_INTERVAL)

	end

	return true

end

--============================================================
-- FINAL R + LEFT CLICK PHASE
--============================================================
-- R and left mouse click are started
-- on every cycle together.
--
-- If the tool gets unequipped,
-- the loop immediately ends.
--============================================================

local function runCombinedPhase(tool)

	while cycleRunning do

		-- STOP EVERYTHING IF TOOL IS UNEQUIPPED
		if not isToolEquipped(tool) then
			return
		end

		-- Start R and left click at approximately
		-- the same time.

		task.spawn(function()

			if cycleRunning
				and isToolEquipped(tool) then

				pressR()

			end

		end)

		task.spawn(function()

			if cycleRunning
				and isToolEquipped(tool) then

				pressLeftMouse()

			end

		end)

		task.wait(COMBINED_INTERVAL)

	end

end

--============================================================
-- MAIN SEQUENCE
--============================================================

local function runSequence()

	if not selectedTool then

		status.Text =
			"STATUS: SELECT A TOOL FIRST"

		return

	end

	cycleRunning = true

	actionButton.Text =
		"■  STOP"

	task.spawn(function()

		local tool = selectedTool

		--====================================================
		-- STEP 1
		-- EQUIP
		--====================================================

		status.Text =
			"STATUS: EQUIPPING"

		if not equipTool(tool) then

			status.Text =
				"STATUS: EQUIP FAILED"

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			return

		end

		task.wait(EQUIP_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- STEP 2
		-- FIRST LEFT CLICK
		--====================================================

		status.Text =
			"STATUS: FIRST HIT"

		activateTool(tool)

		task.wait(0.05)

		if not cycleRunning then
			return
		end

		--====================================================
		-- STEP 3
		-- R SPAM FOR 2 SECONDS
		--====================================================

		status.Text =
			"STATUS: R SPAM — 2 SEC"

		local firstPhaseFinished =
			runFirstRPhase(tool)

		-- R spam has stopped here.
		-- Nothing sends R during the unequip.

		if not firstPhaseFinished then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: TOOL UNEQUIPPED"

			return

		end

		if not cycleRunning then
			return
		end

		--====================================================
		-- STEP 4
		-- UNEQUIP
		--====================================================

		status.Text =
			"STATUS: UNEQUIPPING"

		if not unequipTool(tool) then

			status.Text =
				"STATUS: UNEQUIP FAILED"

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			return

		end

		-- R spam is completely stopped here.

		task.wait(RESET_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- STEP 5
		-- RE-EQUIP
		--====================================================

		status.Text =
			"STATUS: RE-EQUIPPING"

		if not equipTool(tool) then

			status.Text =
				"STATUS: RE-EQUIP FAILED"

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			return

		end

		task.wait(EQUIP_DELAY)

		if not cycleRunning then
			return
		end

		--====================================================
		-- STEP 6
		-- SECOND LEFT CLICK
		--====================================================

		status.Text =
			"STATUS: SECOND HIT"

		activateTool(tool)

		--====================================================
		-- STEP 7
		-- WAIT AFTER SECOND CLICK
		--====================================================

		status.Text =
			"STATUS: PREPARING COMBO"

		task.wait(SECOND_CLICK_WAIT)

		if not cycleRunning then
			return
		end

		if not isToolEquipped(tool) then

			cycleRunning = false

			actionButton.Text =
				"⚔  KICK + HIT"

			status.Text =
				"STATUS: TOOL UNEQUIPPED"

			return

		end

		--====================================================
		-- STEP 8
		-- R + LEFT CLICK TOGETHER
		--====================================================

		status.Text =
			"STATUS: R + LEFT CLICK"

		runCombinedPhase(tool)

		--====================================================
		-- FINISHED / STOPPED
		--====================================================

		cycleRunning = false

		actionButton.Text =
			"⚔  KICK + HIT"

		if not isToolEquipped(tool) then

			status.Text =
				"STATUS: TOOL UNEQUIPPED"

		else

			status.Text =
				"STATUS: READY"

		end

	end)

end

